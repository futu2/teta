{
  "name": "@teta/teta",
  "module": "./mod.ts",
  "version": "0.4.30",
  "exports": {
    ".": "./mod.ts",
    "./query": "./query.ts",
    "./expr": "./expr.ts",
    "./pipe": "./pipe.ts",
    "./advanced": "./advanced.ts"
  },
  "types": "./mod.ts",
  "type": "module",
  "scripts": {
    "test": "bun test --parallel tests",
    "test:all": "bun test --parallel",
    "test:runtime:bun": "bun run tests/runtime_smoke.ts",
    "test:runtime:node": "tsx tests/runtime_smoke.ts",
    "test:runtime:deno": "deno run --node-modules-dir=auto tests/runtime_smoke.ts",
    "bench:render": "bun run ../../benchmarks/render.ts",
    "bench:render:check": "bun run ../../benchmarks/render_regression.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run test && bun run typecheck"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.4.4-r.3",
    "@electric-sql/pglite": "^0.4.6",
    "@types/bun": "latest",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@teta/sql": "workspace:*",
    "node-sql-parser": "^5.4.0"
  }
}
